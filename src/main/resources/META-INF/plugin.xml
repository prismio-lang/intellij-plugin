<idea-plugin>
    <id>io.prismio</id>
    <name>Prismio Language Support</name>
    <vendor url="https://prismio.org">
        Prismio
    </vendor>

    <description><![CDATA[
        <h2>Prismio Language Support</h2>
        <p>
            Language support for Prismio (.psm files) in JetBrains IDEs.
        </p>

        <h3>Features:</h3>
        <ul>
            <li><b>Syntax Highlighting</b> - Theme-aware lexical and semantic colors for declarations, calls, types, imports, fields, variables, constants, and enum variants</li>
            <li><b>Code Completion</b> - Keyword, type, and live template suggestions</li>
            <li><b>Code Formatting</b> - Automatic formatting with customizable code style settings</li>
            <li><b>Live Templates</b> - Snippets for fn, struct, enum, impl, if, while, for, match, let, and more</li>
            <li><b>Delimiter Matching</b> - Auto-closing of parentheses, brackets, braces, quotes, and block comments</li>
            <li><b>Smart Indentation</b> - Brace-aware blocks and consistent block-comment continuation</li>
            <li><b>Comment Toggling</b> - Line and block comment support (Ctrl+/)</li>
            <li><b>Structure View</b> - Navigate code structure via the Structure panel</li>
            <li><b>Code Folding</b> - Collapse multiline function bodies from the editor gutter</li>
            <li><b>Line Breakpoints</b> - Add persistent breakpoint markers on meaningful Prismio lines</li>
            <li><b>Find Usages</b> - Identifier-aware usage search and element descriptions</li>
            <li><b>Documentation</b> - Declaration summaries and toggleable rendered documentation comments</li>
            <li><b>Color Settings</b> - Fully configurable color scheme for all token types</li>
            <li><b>Spellchecking</b> - Integrated spell checking for strings and comments</li>
            <li><b>Go to Symbol</b> - Navigate to symbols across the project</li>
            <li><b>New File Action</b> - Create .psm files from the New menu</li>
        </ul>
    ]]></description>

    <change-notes><![CDATA[
        <h3>Version 1.0.0</h3>
        <ul>
            <li>Rich theme-aware semantic highlighting for declarations, calls, types, imports, fields, variables, constants, and enum variants</li>
            <li>Code completion for keywords, types, and live templates</li>
            <li>Code formatting with customizable style settings</li>
            <li>15 live templates (fn, struct, enum, impl, if, while, for, match, let, and more)</li>
            <li>Brace, bracket, quote, and block-comment auto-closing</li>
            <li>Smart brace-aware indentation on Enter</li>
            <li>Line and block comment toggling</li>
            <li>Structure view and Go to Symbol navigation</li>
            <li>Function-body code folding and gutter line-breakpoint markers</li>
            <li>Find usages and Go to Symbol</li>
            <li>Quick documentation provider</li>
            <li>Configurable color settings page</li>
            <li>Spellchecking in strings and comments</li>
            <li>New Prismio File action with file icon</li>
            <li>Compatible with IntelliJ IDEA, CLion, and other JetBrains IDEs based on platform 262+</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.spellchecker</depends>
    <depends>com.intellij.modules.xdebugger</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- File Type -->
        <fileType
                name="Prismio File"
                implementationClass="io.prismio.PrismioFileType"
                fieldName="INSTANCE"
                language="Prismio"
                extensions="psm"/>

        <!-- Parser and Lexer -->
        <lang.parserDefinition
                language="Prismio"
                implementationClass="io.prismio.parser.PrismioParserDefinition"/>

        <!-- Syntax Highlighting -->
        <lang.syntaxHighlighterFactory
                language="Prismio"
                implementationClass="io.prismio.highlighter.PrismioSyntaxHighlighterFactory"/>

        <!-- Color Settings -->
        <colorSettingsPage
                implementation="io.prismio.settings.PrismioColorSettingsPage"/>

        <!-- Readable call colors tuned separately for light and dark schemes. -->
        <additionalTextAttributes scheme="Default" file="colorSchemes/PrismioDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/PrismioDarcula.xml"/>

        <!-- Annotator for Semantic Highlighting -->
        <annotator
                language="Prismio"
                implementationClass="io.prismio.annotator.PrismioAnnotator"/>

        <!-- Code Completion -->
        <completion.contributor
                language="Prismio"
                implementationClass="io.prismio.completion.PrismioCompletionContributor"/>

        <!-- Code Formatting -->
        <lang.formatter
                language="Prismio"
                implementationClass="io.prismio.formatter.PrismioFormattingModelBuilder"/>

        <!-- Function Body Folding -->
        <lang.foldingBuilder
                language="Prismio"
                implementationClass="io.prismio.folding.PrismioFoldingBuilder"/>

        <!-- Code Style Settings -->
        <codeStyleSettingsProvider
                implementation="io.prismio.settings.PrismioCodeStyleSettingsProvider"/>

        <langCodeStyleSettingsProvider
                implementation="io.prismio.settings.PrismioLanguageCodeStyleSettingsProvider"/>

        <!-- Comment Support -->
        <lang.commenter
                language="Prismio"
                implementationClass="io.prismio.editor.PrismioCommenter"/>

        <!-- Brace Matching -->
        <lang.braceMatcher
                language="Prismio"
                implementationClass="io.prismio.editor.PrismioBraceMatcher"/>

        <!-- Quote Handler -->
        <lang.quoteHandler
                language="Prismio"
                implementationClass="io.prismio.editor.PrismioQuoteHandler"/>

        <!-- Typed Handler for Auto-completion -->
        <typedHandler
                implementation="io.prismio.handler.PrismioTypedHandler"/>

        <!-- Enter Handler for Indentation -->
        <enterHandlerDelegate
                implementation="io.prismio.handler.PrismioEnterHandler"/>

        <!-- Structure View -->
        <lang.psiStructureViewFactory
                language="Prismio"
                implementationClass="io.prismio.navigation.PrismioStructureViewFactory"/>

        <!-- File Templates -->
        <internalFileTemplate name="PrismioFile"/>

        <!-- Find Usages -->
        <lang.findUsagesProvider
                language="Prismio"
                implementationClass="io.prismio.navigation.PrismioFindUsagesProvider"/>

        <!-- Documentation Provider -->
        <lang.documentationProvider
                language="Prismio"
                implementationClass="io.prismio.documentation.PrismioDocumentationProvider"/>

        <!-- Toggle Rendered View for /** documentation comments -->
        <platform.backend.documentation.inlineDocumentationProvider
                implementation="io.prismio.documentation.PrismioInlineDocumentationProvider"/>

        <!-- Spellchecking -->
        <spellchecker.support
                language="Prismio"
                implementationClass="io.prismio.spellcheck.PrismioSpellcheckingStrategy"/>

        <!-- Go to Symbol -->
        <gotoSymbolContributor
                implementation="io.prismio.navigation.PrismioChooseByNameContributor"/>

        <!-- Gutter Line Breakpoints -->
        <xdebugger.breakpointType
                implementation="io.prismio.debugger.PrismioLineBreakpointType"/>
    </extensions>

    <actions>
        <!-- New File Action -->
        <action
                id="io.prismio.action.createFile"
                class="io.prismio.template.CreatePrismioFileAction"
                text="Prismio File"
                description="Create new Prismio file"
                icon="/icons/prismio.png">
            <add-to-group group-id="NewGroup" anchor="first"/>
        </action>
    </actions>
</idea-plugin>
